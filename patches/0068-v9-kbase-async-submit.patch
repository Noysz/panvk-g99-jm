+/* True if the payload of a kbase CPU sync is work that was set pending with
+ * this (wait, data) pair and has not been seen complete yet. A queue that runs
+ * all of its work in submission order does not need a CPU wait for such a
+ * sync before it submits more work. */
+bool
+panvk_kbase_sync_pending_on(struct vk_sync *sync,
+                            panvk_kbase_sync_wait_func wait, void *data)
+{
+   if (sync->type->wait_many != kbase_cpu_sync_wait_many)
+      return false;
+
+   struct kbase_cpu_sync *ks = container_of(sync, struct kbase_cpu_sync, sync);
+   mtx_lock(&ks->mutex);
+   bool pending = (ks->state == KBASE_CPU_SYNC_PENDING ||
+                   ks->state == KBASE_CPU_SYNC_WAITING) &&
+                  ks->pending_wait == wait && ks->pending_data == data;
+   mtx_unlock(&ks->mutex);
+   return pending;
+}
