+/* Resets the job headers and the tiler context of a batch that already ran,
+ * so it can run again. */
+static void
+panvk_batch_reset_for_reissue(struct panvk_cmd_buffer *cmdbuf,
+                              struct panvk_batch *batch)
+{
+   util_dynarray_foreach(&batch->jobs, void *, job)
