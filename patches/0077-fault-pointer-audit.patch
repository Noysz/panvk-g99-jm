+static uint64_t
+fa_mem_available_mb(void)
+{
+   FILE *f = fopen("/proc/meminfo", "r");
+   char line[128];
+   uint64_t kb = 0;
+
+   if (!f)
+      return 0;
+   while (fgets(line, sizeof(line), f)) {
+      if (sscanf(line, "MemAvailable: %" SCNu64, &kb) == 1)
+         break;
+   }
+   fclose(f);
+   return kb / 1024;
+}
