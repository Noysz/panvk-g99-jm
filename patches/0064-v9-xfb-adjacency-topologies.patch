+   case PANLIB_XFB_LINE_LIST_ADJ:
+      /* Line i is 4i + 1, 4i + 2. */
+      return (j / 2) * 4 + 1 + j % 2;
+   case PANLIB_XFB_LINE_STRIP_ADJ:
+      /* Line i is i + 1, i + 2. */
+      return j / 2 + 1 + j % 2;
+   case PANLIB_XFB_TRIANGLE_LIST_ADJ:
+      /* Triangle i is 6i, 6i + 2, 6i + 4. */
+      return (j / 3) * 6 + (j % 3) * 2;
+   case PANLIB_XFB_TRIANGLE_STRIP_ADJ: {
+      /* Triangle i is 2i, 2i + 2, 2i + 4 when i is even and
