+static bool
+lower_viewport_writes(nir_shader *nir)
+{
+   if (nir->info.stage != MESA_SHADER_VERTEX)
+      return false;
+
+   nir_variable *temp_vp_var = NULL;
+   bool has_vp_var = false;
+   nir_foreach_variable_with_modes(var, nir,
