+      }
+      p->offsets = gfx->xfb.offsets.gpu;
+      p->in_vertices = vertex_count;
+      p->out_vertices = out_count;
+      p->instances = instance_count;
+      p->topology = topo;
+   }
+
+   for (uint32_t i = 0; i < PANVK_MAX_XFB_BUFFERS; i++) {
+      if (topo >= 0) {
