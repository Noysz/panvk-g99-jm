#version 450

void main() {
    // Fullscreen triangle trick: 3 titik yang nutupin seluruh clip space
    // setelah di-clip, tanpa perlu vertex buffer sama sekali.
    vec2 positions[3] = vec2[](
        vec2(-1.0, -1.0),
        vec2( 3.0, -1.0),
        vec2(-1.0,  3.0)
    );
    gl_Position = vec4(positions[gl_VertexIndex], 0.0, 1.0);
}
