diff --git a/src/panfrost/vulkan/panvk_frame_prof.c b/src/panfrost/vulkan/panvk_frame_prof.c
new file mode 100644
index 0000000..3961047
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_frame_prof.c
@@ -0,0 +1,185 @@
+/*
+ * Copyright 2026 Noysz
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "panvk_frame_prof.h"
+
+#include <inttypes.h>
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#include "panfrost/lib/pan_env.h"
+#include "panvk_device.h"
+
+#define WINDOW_NS 2000000000ull
+
+/* utime + stime of the whole process (every thread), in clock ticks. */
+static uint64_t
+process_cpu_ticks(void)
+{
+   char buf[1024];
+   FILE *f = fopen("/proc/self/stat", "r");
+   if (!f)
+      return 0;
+   size_t n = fread(buf, 1, sizeof(buf) - 1, f);
+   fclose(f);
+   buf[n] = 0;
+
+   /* The command name may contain spaces: fields start after the last ')'. */
+   const char *s = strrchr(buf, ')');
+   if (!s)
+      return 0;
+   unsigned long long utime = 0, stime = 0;
+   if (sscanf(s + 2, "%*c %*d %*d %*d %*d %*d %*u %*u %*u %*u %*u %llu %llu",
+              &utime, &stime) != 2)
+      return 0;
+   return utime + stime;
+}
+
+void
+panvk_frame_prof_init(struct panvk_device *dev)
+{
+   struct panvk_frame_prof *p = &dev->frame_prof;
+   const char *v = pan_env_flag("PANVK_FRAME_PROF");
+
+   memset(p, 0, sizeof(*p));
+   if (!v)
+      return;
+   if (mtx_init(&p->mtx, mtx_plain) != thrd_success)
+      return;
+
+   p->out = stderr;
+   if (strchr(v, '/')) {
+      FILE *f = fopen(v, "a");
+      if (f) {
+         setvbuf(f, NULL, _IOLBF, 0);
+         p->out = f;
+      }
+   }
+   p->start_ns = p->window_ns = os_time_get_nano();
+   p->cpu_ticks = process_cpu_ticks();
+   p->enabled = true;
+   fprintf(p->out, "panvk-frame: profiling on (pid %d), one line per 2 s\n",
+           (int)getpid());
+}
+
+void
+panvk_frame_prof_finish(struct panvk_device *dev)
+{
+   struct panvk_frame_prof *p = &dev->frame_prof;
+
+   if (!p->enabled)
+      return;
+   p->enabled = false;
+   if (p->out && p->out != stderr)
+      fclose(p->out);
+   mtx_destroy(&p->mtx);
+}
+
+static int
+cmp_u32(const void *a, const void *b)
+{
+   uint32_t x = *(const uint32_t *)a, y = *(const uint32_t *)b;
+   return x < y ? -1 : x > y;
+}
+
+void
+panvk_frame_prof_tick(struct panvk_device *dev, uint64_t now)
+{
+   struct panvk_frame_prof *p = &dev->frame_prof;
+
+   if (!p->enabled || now - p->window_ns < WINDOW_NS)
+      return;
+
+   mtx_lock(&p->mtx);
+   if (now - p->window_ns < WINDOW_NS) {
+      mtx_unlock(&p->mtx);
+      return;
+   }
+
+   const double win_s = (now - p->window_ns) / 1e9;
+   const uint64_t gpu = p_atomic_xchg(&p->gpu_busy_ns, 0);
+   const uint64_t submit = p_atomic_xchg(&p->submit_ns, 0);
+   const uint64_t wait = p_atomic_xchg(&p->wait_ns, 0);
+   const uint64_t present = p_atomic_xchg(&p->present_ns, 0);
+   const uint64_t submits = p_atomic_xchg(&p->submits, 0);
+   const uint64_t batches = p_atomic_xchg(&p->batches, 0);
+   const uint64_t vtc = p_atomic_xchg(&p->vtc_ns, 0);
+   const uint64_t frag = p_atomic_xchg(&p->frag_ns, 0);
+   char split[96] = "";
+   if (vtc + frag)
+      snprintf(split, sizeof(split),
+               " | chains: vertex/tiler/compute %.0f%%, fragment %.0f%%",
+               100.0 * vtc / (vtc + frag), 100.0 * frag / (vtc + frag));
+   const uint64_t ticks = process_cpu_ticks();
+   const long hz = sysconf(_SC_CLK_TCK);
+   const double cpu_pct =
+      hz > 0 ? 100.0 * (ticks - p->cpu_ticks) / hz / win_s : 0;
+   const unsigned n = p->nframes;
+   /* Per frame when frames were seen, else per second. */
+   const double per = n ? n : win_s;
+   const char *unit = n ? "frame" : "s";
+
+   if (n) {
+      double sum = 0, sq = 0;
+      for (unsigned i = 0; i < n; i++)
+         sum += p->frame_us[i];
+      const double mean = sum / n;
+      for (unsigned i = 0; i < n; i++)
+         sq += (p->frame_us[i] - mean) * (p->frame_us[i] - mean);
+      qsort(p->frame_us, n, sizeof(p->frame_us[0]), cmp_u32);
+      const uint32_t p99 = p->frame_us[(n * 99) / 100 < n ? (n * 99) / 100
+                                                          : n - 1];
+      fprintf(p->out,
+              "panvk-frame t=%.1fs | %.1f fps, 1%% low %.1f, worst %.0f ms, "
+              "frame time %.1f +- %.1f ms | GPU busy %.0f%% | process CPU "
+              "%.0f%% | per frame: submit %.2f ms, wait for GPU %.2f ms, "
+              "present %.2f ms, %.1f submits, %.1f passes%s\n",
+              (now - p->start_ns) / 1e9, n / win_s,
+              p99 ? 1e6 / p99 : 0, p->frame_us[n - 1] / 1000.0,
+              mean / 1000.0, sqrt(sq / n) / 1000.0,
+              100.0 * gpu / (now - p->window_ns), cpu_pct,
+              submit / 1e6 / per, wait / 1e6 / per, present / 1e6 / per,
+              submits / per, batches / per, split);
+   } else {
+      fprintf(p->out,
+              "panvk-frame t=%.1fs | no presents seen | GPU busy %.0f%% | "
+              "process CPU %.0f%% | per %s: submit %.2f ms, wait for GPU "
+              "%.2f ms, %.1f submits, %.1f passes%s\n",
+              (now - p->start_ns) / 1e9, 100.0 * gpu / (now - p->window_ns),
+              cpu_pct, unit, submit / 1e6 / per, wait / 1e6 / per,
+              submits / per, batches / per, split);
+   }
+
+   p->nframes = 0;
+   p->window_ns = now;
+   p->cpu_ticks = ticks;
+   mtx_unlock(&p->mtx);
+}
+
+void
+panvk_frame_prof_present(struct panvk_device *dev, uint64_t start_ns,
+                         uint64_t end_ns)
+{
+   struct panvk_frame_prof *p = &dev->frame_prof;
+
+   if (!p->enabled)
+      return;
+
+   mtx_lock(&p->mtx);
+   if (p->last_present_ns && p->nframes < PANVK_FRAME_PROF_MAX_FRAMES) {
+      uint64_t us = (start_ns - p->last_present_ns) / 1000;
+      p->frame_us[p->nframes++] = us > UINT32_MAX ? UINT32_MAX : us;
+   }
+   p->last_present_ns = start_ns;
+   mtx_unlock(&p->mtx);
+
+   p_atomic_add(&p->present_ns, end_ns - start_ns);
+   panvk_frame_prof_tick(dev, end_ns);
+}
diff --git a/src/panfrost/vulkan/panvk_frame_prof.h b/src/panfrost/vulkan/panvk_frame_prof.h
new file mode 100644
index 0000000..4db4c20
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_frame_prof.h
@@ -0,0 +1,55 @@
+/*
+ * Copyright 2026 Noysz
+ * SPDX-License-Identifier: MIT
+ */
+
+/* PANVK_FRAME_PROF=1 (stderr) or =<file>: every 2 s, frame pacing and where
+ * the time goes. Frames are counted at vkQueuePresentKHR. GPU busy is the
+ * union of [submit, completion seen] of every kbase submission, so it can
+ * read a little high when nobody waits for a while. Off by default; when
+ * off every hook is one predictable branch. */
+
+#ifndef PANVK_FRAME_PROF_H
+#define PANVK_FRAME_PROF_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+
+#include "c11/threads.h"
+
+struct panvk_device;
+
+#define PANVK_FRAME_PROF_MAX_FRAMES 4096
+
+struct panvk_frame_prof {
+   bool enabled;
+   FILE *out;
+   mtx_t mtx;
+   uint64_t start_ns, window_ns, last_present_ns;
+   uint64_t cpu_ticks; /* process utime + stime at window start */
+
+   /* Present intervals of the current window, in us. */
+   uint32_t frame_us[PANVK_FRAME_PROF_MAX_FRAMES];
+   unsigned nframes;
+
+   /* Added from the queue and WSI hooks (atomics). */
+   uint64_t gpu_busy_ns, submit_ns, wait_ns, present_ns;
+   uint64_t submits, batches, waits;
+   /* PANVK_KBASE_SYNC_SUBMIT=1 only (one chain at a time, each waited
+    * for): wall time of the vertex/tiler/compute and fragment chains. */
+   uint64_t vtc_ns, frag_ns;
+};
+
+void panvk_frame_prof_init(struct panvk_device *dev);
+void panvk_frame_prof_finish(struct panvk_device *dev);
+
+/* A present that took [start_ns, end_ns] on the calling thread. */
+void panvk_frame_prof_present(struct panvk_device *dev, uint64_t start_ns,
+                              uint64_t end_ns);
+
+/* Prints the window if 2 s passed (also called from submits, so a log keeps
+ * coming when presents are not seen). */
+void panvk_frame_prof_tick(struct panvk_device *dev, uint64_t now_ns);
+
+#endif /* PANVK_FRAME_PROF_H */
diff --git a/src/panfrost/vulkan/panvk_mem_prof.c b/src/panfrost/vulkan/panvk_mem_prof.c
new file mode 100644
index 0000000..b912bc5
--- /dev/null
+++ b/src/panfrost/vulkan/panvk_mem_prof.c
@@ -0,0 +1,162 @@
+/*
+ * Copyright 2026 Noysz
+ * SPDX-License-Identifier: MIT
+ */
+
+#include "panvk_mem_prof.h"
+
+#include <inttypes.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+
+#include "util/os_time.h"
+#include "util/u_atomic.h"
+
+#include "panfrost/lib/pan_env.h"
+#include "panvk_device.h"
+#include "panvk_physical_device.h"
+#include "panvk_priv_bo.h"
+
+#ifdef HAVE_PAN_KMOD_KBASE
+#include "kmod/kbase_kmod.h"
+#endif
+
+#define MB(x) ((double)(x) / (1024.0 * 1024.0))
+
+void
+panvk_mem_prof_init(struct panvk_device *dev)
+{
+   struct panvk_mem_prof *p = &dev->mem_prof;
+   const char *v = pan_env_flag("PANVK_MEM_PROF");
+
+   memset(p, 0, sizeof(*p));
+   if (!v)
+      return;
+
+   p->enabled = true;
+   p->out = stderr;
+   if (strchr(v, '/')) {
+      FILE *f = fopen(v, "a");
+      if (f) {
+         setvbuf(f, NULL, _IOLBF, 0);
+         p->out = f;
+      }
+   }
+   p->start_ns = os_time_get_nano();
+   p->last_ns = 0;
+   fprintf(p->out, "panvk-mem: profiling on (pid %d)\n", (int)getpid());
+}
+
+void
+panvk_mem_prof_finish(struct panvk_device *dev)
+{
+   struct panvk_mem_prof *p = &dev->mem_prof;
+
+   if (!p->enabled)
+      return;
+
+   p->last_ns = 0;
+   panvk_mem_prof_tick(dev);
+   if (p->out && p->out != stderr)
+      fclose(p->out);
+   p->enabled = false;
+}
+
+/* "Key:   1234 kB" from a /proc file, in bytes; 0 if missing. */
+static uint64_t
+proc_kb(const char *buf, const char *key)
+{
+   const char *s = buf ? strstr(buf, key) : NULL;
+
+   if (!s)
+      return 0;
+
+   return strtoull(s + strlen(key), NULL, 10) * 1024;
+}
+
+static char *
+read_small_file(const char *path, char *buf, size_t size)
+{
+   FILE *f = fopen(path, "r");
+
+   if (!f)
+      return NULL;
+
+   size_t n = fread(buf, 1, size - 1, f);
+   fclose(f);
+   buf[n] = 0;
+   return buf;
+}
+
+static uint64_t
+commit_of(struct panvk_priv_bo *bo)
+{
+#ifdef HAVE_PAN_KMOD_KBASE
+   if (bo && bo->bo)
+      return kbase_kmod_bo_commit_bytes(bo->bo);
+#endif
+   return 0;
+}
+
+void
+panvk_mem_prof_tick(struct panvk_device *dev)
+{
+   struct panvk_mem_prof *p = &dev->mem_prof;
+
+   if (!p->enabled)
+      return;
+
+   uint64_t now = os_time_get_nano();
+   if (p->last_ns && now - p->last_ns < 2000000000ull)
+      return;
+   p->last_ns = now;
+
+   struct panvk_physical_device *pdev =
+      to_panvk_physical_device(dev->vk.physical);
+   uint64_t devmem = p_atomic_read(&pdev->memory.heap_used);
+   uint64_t cached = p_atomic_read(&dev->pool_cached_bytes);
+
+   uint64_t bos = 0, va = 0, commit = 0, growable = 0, allocs = 0, frees = 0;
+   uint64_t grow_commit = 0, lazy_n = 0, lazy_va = 0, lazy_commit = 0;
+#ifdef HAVE_PAN_KMOD_KBASE
+   struct kbase_kmod_mem_stats ks;
+   kbase_kmod_mem_stats(&ks);
+   bos = ks.live_bos;
+   va = ks.live_bytes;
+   commit = ks.commit_bytes;
+   growable = ks.growable_bos;
+   allocs = ks.allocs;
+   frees = ks.frees;
+   grow_commit = ks.growable_commit_bytes;
+   lazy_n = ks.lazy_bos;
+   lazy_va = ks.lazy_va_bytes;
+   lazy_commit = ks.lazy_commit_bytes;
+#endif
+
+   char buf[4096];
+   char *st = read_small_file("/proc/self/status", buf, sizeof(buf));
+   uint64_t rss = proc_kb(st, "VmRSS:"), anon = proc_kb(st, "RssAnon:"),
+            file = proc_kb(st, "RssFile:"), shmem = proc_kb(st, "RssShmem:");
+   char *mi = read_small_file("/proc/meminfo", buf, sizeof(buf));
+   uint64_t avail = proc_kb(mi, "MemAvailable:");
+
+   fprintf(p->out,
+           "panvk-mem t=%.1fs | kbase BOs %" PRIu64 " (%.1f MB VA, %.1f MB "
+           "committed at alloc, %" PRIu64 " growable) +%" PRIu64 "/-%" PRIu64
+           " | VkDeviceMemory %.1f MB (lazy: %" PRIu64 " BOs, %.1f MB of "
+           "%.1f MB backed) | all growable backed %.1f MB | cmd pool cache "
+           "%.1f MB | heaps "
+           "committed: tiler %.1f, poly %.1f, indirect varyings %.1f MB | "
+           "RSS %.1f MB (anon %.1f, file %.1f, shmem %.1f) | MemAvailable "
+           "%.1f MB\n",
+           (now - p->start_ns) / 1e9, bos, MB(va), MB(commit), growable,
+           allocs - p->last_allocs, frees - p->last_frees, MB(devmem),
+           lazy_n, MB(lazy_commit), MB(lazy_va), MB(grow_commit), MB(cached), MB(commit_of(dev->tiler_heap)),
+           MB(commit_of(dev->poly_heap_data)),
+           MB(commit_of(dev->indirect_varying_buffer)), MB(rss), MB(anon),
+           MB(file), MB(shmem), MB(avail));
+
+   p->last_allocs = allocs;
+   p->last_frees = frees;
+}
