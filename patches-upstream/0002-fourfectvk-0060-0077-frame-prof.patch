          uint32_t maxx = s->offset.x + s->extent.width;
@@ -2936,7 +2984,7 @@ panvk_draw_prepare_malloc_vertex_job(struct panvk_cmd_buffer *cmdbuf,
           * needs was not established. The varying shader shares the position
