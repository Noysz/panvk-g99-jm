+      p_atomic_set(&event->kbase_set, 0);
+      return VK_SUCCESS;
+   }
+
    struct drm_syncobj_array objs = {
       .handles = (uint64_t)(uintptr_t)&event->syncobj,
       .count_handles = 1};
