+bool
+kbase_kmod_csf_has_error(const struct pan_kmod_dev *dev)
+{
+   const struct kbase_kmod_dev *kbase_dev =
+      container_of(dev, const struct kbase_kmod_dev, base);
+   return p_atomic_read(&kbase_dev->csf_error);
+}
