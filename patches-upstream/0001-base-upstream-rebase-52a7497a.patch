+   k->cpu_fence_export = os_get_option("PANVK_KBASE_CPU_FENCE_EXPORT") != NULL;
+   k->trace = os_get_option("PANVK_KBASE_FENCE_TRACE") != NULL;
+   k->ctrl_no_fence_wait_dep =
