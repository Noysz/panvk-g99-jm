+                          BASE_JD_DEP_TYPE_ORDER,
+                          k->ctrl_no_fence_wait_dep ? 0 : wait_atom,
+                          BASE_JD_DEP_TYPE_ORDER);
+      else
+         panvk_kbase_atom(atoms[a], nums[a], jobs[i].jc, core_req, nums[a - 1],
+                          BASE_JD_DEP_TYPE_DATA, 0, 0);
