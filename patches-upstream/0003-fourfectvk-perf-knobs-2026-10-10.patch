+   }
+   if (len > 0 && len < (int)sizeof(line) && line[len - 1] == ',')
+      line[len - 1] = 0;
+   fprintf(p->out, "%s\n", line);
+
+   uint64_t total = 0;
+   for (unsigned i = 0; i < p->ngroups; i++)
+      total += p->groups[i].vtc_ns + p->groups[i].frag_ns;
+
