       k->atom_info[nums[a]] = (struct panvk_kbase_atom_info){
          .cmdbuf = jobs[i].cmdbuf, .batch = jobs[i].batch,
          .core_req = jobs[i].core_req, .batch_idx = jobs[i].batch_idx};
