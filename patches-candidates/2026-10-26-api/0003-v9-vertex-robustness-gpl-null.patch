+#if PAN_ARCH == 9
+static bool
+panvk_v9_lower_robust_attr(nir_builder *b, nir_intrinsic_instr *intr,
+                          UNUSED void *data)
+{
+   if (intr->intrinsic != nir_intrinsic_load_attr_pan ||
+       intr->num_components != 4 ||
+       !(nir_def_components_read(&intr->def) & BITFIELD_BIT(3)))
+      return false;
+
+   b->cursor = nir_after_instr(&intr->instr);
+   const nir_alu_type type = nir_intrinsic_dest_type(intr);
+   const unsigned bits = intr->def.bit_size;
+   nir_def *handle = intr->src[2].ssa;
+   nir_def *address = nir_lea_attr_pan(b, handle, intr->src[0].ssa,
+                                      intr->src[1].ssa, .src_type = type);
+   nir_def *oob = nir_ilt_imm(b, nir_channel(b, address, 1), 0);
+   nir_def *order = nir_iand_imm(b, nir_channel(b, address, 2), 0xff);
+   nir_def *no_alpha = nir_ior(
+      b, nir_ieq_imm(b, nir_iand_imm(b, order, ~6),
+                    MALI_RGB_COMPONENT_ORDER_RGB1),
+      nir_ior(b, nir_ieq_imm(b, order, MALI_RGB_COMPONENT_ORDER_RRR1),
+              nir_ieq_imm(b, order, MALI_RGB_COMPONENT_ORDER_0001)));
+   nir_def *one = nir_alu_type_get_base_type(type) == nir_type_float
+                    ? nir_imm_floatN_t(b, 1.0, bits)
+                    : nir_imm_intN_t(b, 1, bits);
+   nir_def *fallback = nir_bcsel(b, no_alpha,
+                                one, nir_imm_intN_t(b, 0, bits));
+   nir_def *value = nir_vec4(b, nir_channel(b, &intr->def, 0),
+                            nir_channel(b, &intr->def, 1),
+                            nir_channel(b, &intr->def, 2),
+                            nir_bcsel(b, oob, fallback,
+                                      nir_channel(b, &intr->def, 3)));
+   nir_def_rewrite_uses_after(&intr->def, value);
+   return true;
+}
