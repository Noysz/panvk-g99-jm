+static inline uint64_t
+panvk_tiler_heap_plan_size(uint64_t heap_size)
+{
+   return heap_size < PANVK_JM_TILER_HEAP_PLAN_SIZE ? heap_size
+                                                   : PANVK_JM_TILER_HEAP_PLAN_SIZE;
+}
