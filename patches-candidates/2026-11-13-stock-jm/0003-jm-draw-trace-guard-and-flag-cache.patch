+DEBUG_GET_ONCE_BOOL_OPTION(cache_draw_flags, "PANVK_CACHE_DRAW_FLAGS", false)
+
+static inline bool
+panvk_draw_env_flag(const char *name, int *cached)
+{
+   if (!debug_get_option_cache_draw_flags())
+      return pan_env_flag(name) != NULL;
+
+   int value = p_atomic_read_relaxed(cached);
+   if (value < 0) {
+      value = pan_env_flag(name) != NULL;
+      p_atomic_set(cached, value);
+   }
+   return value;
+}
