+DEBUG_GET_ONCE_BOOL_OPTION(tiler_batch_budget, "PANVK_TILER_BATCH_BUDGET", false)
+
+static VkResult
+panvk_limit_tiler_batch(struct panvk_cmd_buffer *cmdbuf,
+                       const struct panvk_draw_data *draw,
+                       const struct panvk_shader_variant *vs,
+                       const struct panvk_shader_variant *fs)
+{
+   if (!debug_get_option_tiler_batch_budget() ||
+       cmdbuf->vk.dynamic_graphics_state.rs.rasterizer_discard_enable)
+      return VK_SUCCESS;
+
+   struct panvk_device *dev = to_panvk_device(cmdbuf->vk.base.device);
+   const uint64_t budget = pan_kmod_bo_size(dev->tiler_heap->bo) / 8;
+   struct panvk_batch *batch = cmdbuf->cur_batch;
+
+   if (cmdbuf->state.gfx.tess.tes || cmdbuf->state.gfx.gs.shader ||
+       cmdbuf->state.gfx.xfb.enabled || draw->info.indirect.buffer_dev_addr ||
+       cmdbuf->state.gfx.render.layer_count != 1 ||
+       cmdbuf->state.gfx.render.view_mask ||
+       cmdbuf->state.gfx.vs.shader->writes_viewport) {
+      batch->tiler_vertex_bytes = budget;
+      return VK_SUCCESS;
+   }
+
+   const uint64_t vertices =
+      (uint64_t)draw->info.vertex.count * draw->info.instance.count;
+   const unsigned stride =
+      16 + ((fs && panvk_priv_mem_check_alloc(vs->spds.var))
+               ? vs->info.varyings.formats.generic_size_B
+               : 0);
+   const uint64_t bytes =
+      vertices > budget / stride ? budget : vertices * stride;
+
+   if (batch->tiler_vertex_bytes &&
+       bytes > budget - batch->tiler_vertex_bytes) {
+      panvk_per_arch(cmd_close_batch)(cmdbuf);
+      if (vk_command_buffer_has_error(&cmdbuf->vk))
+         return vk_command_buffer_get_record_result(&cmdbuf->vk);
+
+      batch = panvk_per_arch(cmd_open_batch)(cmdbuf);
+      if (!batch || vk_command_buffer_has_error(&cmdbuf->vk))
+         return vk_command_buffer_get_record_result(&cmdbuf->vk);
+   }
+
+   batch->tiler_vertex_bytes += bytes;
+   return VK_SUCCESS;
+}
